#!/usr/bin/env python3
# fake opencode CLI for tests: logs argv + identity env to $FAKE_CLI_LOG; never calls a provider.
NAME = "opencode"
import json, os, sys
ARGV = sys.argv[1:]
LOG = os.environ.get("FAKE_CLI_LOG")
def log():
    if LOG:
        with open(LOG, "a", encoding="utf-8") as fh:
            fh.write(json.dumps({"cli": NAME, "argv": ARGV, "agent_id": os.environ.get("FUSION_AGENT_ID"),
                                 "board_profile": os.environ.get("BOARD_PROFILE"),
                                 "board": os.environ.get("FUSION_BOARD"), "cwd": os.getcwd()}) + "\n")
def flag_value(name):
    return ARGV[ARGV.index(name) + 1] if name in ARGV and ARGV.index(name) + 1 < len(ARGV) else None
if "--help" in ARGV:
    print("opencode run [message..]\n  -m, --model  provider/model[#variant]\n  --format  default|json\n  --dir")
    sys.exit(0)
log()
if os.environ.get("FAKE_BAD_JSON") == "1":
    print("this is not json {{{")
    sys.exit(0)
model = (flag_value("-m") or "").split("#")[0].split("/")[-1]
print(json.dumps({"type": "text", "sessionID": "ses_fake1",
                  "part": {"type": "text", "text": "hello opencode", "messageID": "m1", "sessionID": "ses_fake1"}}))
print(json.dumps({"type": "step_finish", "sessionID": "ses_fake1",
                  "part": {"type": "step-finish", "modelID": model, "tokens": {"input": 10, "output": 5}, "cost": 0.01}}))
